# Docker Compose (desenvolvimento)
API_PORT=3000
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173
# Execução Node fora dos containers
NODE_ENV=development
PORT=3000
# Fora dos containers, informe um PostgreSQL acessível nesta máquina.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aeroclima
DB_USER=aeroclima
DB_PASSWORD=aeroclima_local_only

# Integrações opcionais: sem chave, o ambiente continua iniciando.
# Crie uma chave no painel Geoapify e coloque-a apenas no .env local.
GEOAPIFY_API_KEY=
